# ============================================================
# Fiscore — Variables de entorno
# Copiar como .env para desarrollo local (el .env NO se versiona).
# En producción se configuran en el panel de Render.
# ============================================================

# ── Servidor ────────────────────────────────────────────────
# PORT lo inyecta Render; no definirlo en producción.
# PORT=8080

# Raíz de la aplicación. En local se usa '/fiscore'; para servir desde la
# raíz hay que dejarlo VACÍO, no poner '/': Spring rechaza "/" con
# "ContextPath must start with '/' and not end with '/'".
# El perfil 'prod' ya lo deja vacío por defecto, así que en Render no se define.
CONTEXT_PATH=/fiscore

# Perfil activo. 'prod' activa caché de plantillas, registro reducido,
# cookies seguras y el pool ajustado a Neon.
SPRING_PROFILES_ACTIVE=prod

# ── Base de datos PostgreSQL ─────────────────────────────────
# Neon entrega la cadena en formato libpq:
#   postgresql://usuario:password@host/base?sslmode=require&channel_binding=require
# y hay que traducirla a JDBC (detalle en DEPLOY.md §3):
#
#   DB_URL      = jdbc:postgresql://<host>/<base>?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
#   DB_USERNAME = <usuario>
#   DB_PASSWORD = <password>
#
# · El TLS es obligatorio: Neon rechaza conexiones sin cifrar.
# · verify-full + DefaultJavaSSLFactory valida el certificado contra el
#   almacén de la JVM. sslmode=require cifra pero NO valida, lo que deja
#   la puerta abierta a un intermediario.
# · channel_binding es de libpq, no de JDBC: el driver lo ignora.
# · Quitar el sufijo '-pooler' del host y usar el endpoint directo.
# · Entrecomillar el valor si se usa en shell, por el '&'.
DB_URL=jdbc:postgresql://localhost:5432/contasuite
DB_USERNAME=postgres
DB_PASSWORD=CAMBIAR_EN_PRODUCCION

# Tamaño máximo del pool de conexiones
DB_POOL_SIZE=5

# ── Ajustes finos del pool (opcionales) ──────────────────────
# Solo hacen falta si Neon corta conexiones, o si se migra a una base
# siempre encendida (entonces DB_POOL_MIN_IDLE=1 o 2).
# DB_POOL_MIN_IDLE=0
# DB_IDLE_TIMEOUT=60000
# DB_MAX_LIFETIME=600000
# DB_CONNECTION_TIMEOUT=30000

# ── Esquema ──────────────────────────────────────────────────
# update = crea las tablas que falten y añade columnas nuevas; nunca borra.
# validate = solo comprueba (usar cuando se adopten migraciones versionadas).
DDL_AUTO=update

# ── Usuario administrador inicial ────────────────────────────
# Solo se crea si la tabla ADM_USUARIOS está vacía; nunca pisa usuarios
# existentes. Cambiar SIEMPRE la contraseña antes del primer despliegue.
SEED_ADMIN=true
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=CAMBIAR_ANTES_DE_DESPLEGAR
SEED_ADMIN_MAIL=admin@fiscore.sv

# Poner a false una vez creado el administrador, para que el arranque
# ni siquiera consulte la tabla.
# SEED_ADMIN=false

# ── Registro ─────────────────────────────────────────────────
# DEBUG en local, INFO en producción
LOG_LEVEL_APP=INFO

# ── Emisión de DTE ───────────────────────────────────────────
# Los parámetros del Ministerio de Hacienda (emisor, tasas, endpoints y
# credenciales) NO se configuran aquí: viven en la tabla DTE_PARAMETRO y
# se editan en la aplicación, en Configuración → Parámetros DTE.
